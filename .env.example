# Environment variables referenced by this buildpack.
#
# Copy this file to use as a reference when setting Heroku config vars:
#   heroku config:set VAR=value
#
# Variables marked (compile) are read by bin/compile at build time and
# require the user-env-compile lab feature on legacy stacks. Variables
# marked (runtime) are read by the generated wp-config.php / start.sh at
# runtime. Variables marked (maintenance) are only used by the scripts in
# support/ that package Nginx/PHP and upload them to S3.

# --- Compile-time versions (see VERSIONS.md) ---

# Version of the prebuilt Nginx package to install. (compile)
NGINX_VERSION=1.4.2

# Version of the prebuilt PHP package to install. (compile)
PHP_VERSION=5.5.2

# Version of WordPress to download from wordpress.org. (compile)
WORDPRESS_VERSION=3.9.1

# S3 bucket that hosts the prebuilt Nginx/PHP packages. (compile)
S3_BUCKET=heroku-buildpack-wordpress

# Install WordPress into a subdirectory of the docroot instead of /.
# e.g. WORDPRESS_DIR=mywordpress installs into public/mywordpress. (compile)
#WORDPRESS_DIR=mywordpress

# --- Runtime behavior ---

# Force HTTPS for the wp-login.php page. (runtime)
FORCE_SSL_LOGIN=true

# Force HTTPS for all admin pages. (runtime)
FORCE_SSL_ADMIN=true

# Enable the WordPress object cache. (runtime)
WP_CACHE=true

# Disable wp-cron on page views; use the Heroku Scheduler instead. (runtime)
DISABLE_WP_CRON=true

# Expose /apc.php and /phpinfo.php. (runtime)
ENABLE_SYSTEM_ACCESS=false

# Credentials for /apc.php and /phpinfo.php when ENABLE_SYSTEM_ACCESS=true.
#SYSTEM_USERNAME=admin
#SYSTEM_PASSWORD=change-me

# Google Analytics tracking ID, consumed by the heroku-google-analytics
# plugin. (runtime)
#GOOG_UA_ID=UA-0000000-0

# --- Maintenance scripts (support/package_nginx, support/package_php) ---

# AWS credentials used to upload prebuilt packages to S3. (maintenance)
#AWS_ID=your-aws-access-key-id
#AWS_SECRET=your-aws-secret-access-key

# Set to true to see curl errors from the S3 helper. (maintenance)
#CURL_S3_DEBUG=false
